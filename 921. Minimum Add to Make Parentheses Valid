class Solution {
    public int minAddToMakeValid(String s) {
        int leftUnmatched = 0; 
        int rightUnmatched = 0; 
        for (char c : s.toCharArray()) {
            if (c == '(') {
                leftUnmatched++;
            } else {
                if (leftUnmatched > 0) {
                    leftUnmatched--; 
                } else {
                    rightUnmatched++; 
                }
            }
        }
        return leftUnmatched + rightUnmatched;
    }
}
